<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusMind.UI.Components.ToolCard">

    <Frame
        BackgroundColor="White"
        CornerRadius="16"
        Padding="16"
        Margin="10"
        HasShadow="True">

        <VerticalStackLayout Spacing="8">

            <Image
                Source="dotnet_bot.png"
                HeightRequest="40"
                WidthRequest="40"/>

            <Label
                Text="Tool Name"
                FontAttributes="Bold"
                FontSize="16"
                TextColor="#2D2D2D"/>

            <Label
                Text="Tool description"
                FontSize="13"
                TextColor="#777777"/>

        </VerticalStackLayout>

    </Frame>

</ContentView>