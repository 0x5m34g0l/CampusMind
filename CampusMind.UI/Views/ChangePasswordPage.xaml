<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusMind.UI.Views.ChangePasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- HEADER -->
            <Grid HeightRequest="140" Padding="20,52,20,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#3730A3" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Back -->
                <Label Text="Back"
                       TextColor="White" FontSize="15"
                       HorizontalOptions="Start" VerticalOptions="Start">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Change Password"
                       FontSize="24" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="End"/>
            </Grid>

            <!-- FORM CARD -->
            <Frame Style="{StaticResource CardFrame}"
                   Margin="20,-28,20,0" Padding="24">
                <VerticalStackLayout Spacing="18">

                    <Label Text="Update your password"
                           Style="{StaticResource BodyLabel}"
                           Margin="0,0,0,4"/>

                    <!-- Current Password -->
                    <Frame Style="{StaticResource InputFrame}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="Old"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   x:Name="CurrentPasswordEntry"
                                   Placeholder="Current Password"
                                   IsPassword="True"
                                   Style="{StaticResource InputEntry}"/>
                        </Grid>
                    </Frame>

                    <!-- New Password -->
                    <Frame Style="{StaticResource InputFrame}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="New"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   x:Name="NewPasswordEntry"
                                   Placeholder="New Password"
                                   IsPassword="True"
                                   TextChanged="OnNewPasswordChanged"
                                   Style="{StaticResource InputEntry}"/>
                        </Grid>
                    </Frame>

                    <!-- Password Strength Bars -->
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                            <BoxView x:Name="StrengthBar1" Grid.Column="0"
                                     HeightRequest="4" CornerRadius="2"
                                     Color="#E5E7EB"/>
                            <BoxView x:Name="StrengthBar2" Grid.Column="1"
                                     HeightRequest="4" CornerRadius="2"
                                     Color="#E5E7EB"/>
                            <BoxView x:Name="StrengthBar3" Grid.Column="2"
                                     HeightRequest="4" CornerRadius="2"
                                     Color="#E5E7EB"/>
                            <BoxView x:Name="StrengthBar4" Grid.Column="3"
                                     HeightRequest="4" CornerRadius="2"
                                     Color="#E5E7EB"/>
                        </Grid>
                        <Label x:Name="StrengthLabel"
                               Text="Password strength"
                               Style="{StaticResource CaptionLabel}"
                               HorizontalOptions="End"/>
                    </VerticalStackLayout>

                    <!-- Confirm New Password -->
                    <Frame Style="{StaticResource InputFrame}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="Confirm"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   x:Name="ConfirmPasswordEntry"
                                   Placeholder="Confirm New Password"
                                   IsPassword="True"
                                   Style="{StaticResource InputEntry}"/>
                        </Grid>
                    </Frame>

                    <!-- Error / Success Label -->
                    <Label x:Name="StatusLabel"
                           FontSize="13" IsVisible="False"
                           HorizontalOptions="Center"/>

                    <!-- Submit Button -->
                    <Button x:Name="SaveButton"
                            Text="Update Password"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSaveClicked"/>

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False" IsVisible="False"
                                       Color="{StaticResource PrimaryColor}"
                                       HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="40" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
