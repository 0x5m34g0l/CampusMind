<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampusMind.UI.Views.RegisterPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ═══ HEADER ═══ -->
            <Grid HeightRequest="230">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F46E5" Offset="0"/>
                            <GradientStop Color="#3730A3" Offset="1"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <!-- Back -->
                <Label Text="← Back"
                       TextColor="White" FontSize="15"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"
                       Margin="20,52,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Label.GestureRecognizers>
                </Label>

                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="8">
                    <Image Source="owl_logo.png"
                           WidthRequest="52" HeightRequest="52"
                           HorizontalOptions="Center"/>
                    <Label Text="Create Account"
                           FontSize="26" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Join CampusMind today"
                           FontSize="13" TextColor="#FFFFFFCC"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ═══ FORM CARD ═══ -->
            <Frame Style="{StaticResource CardFrame}"
                   Margin="20,-28,20,0" Padding="24">
                <VerticalStackLayout Spacing="16">

                    <!-- Full Name -->
                    <Frame Style="{StaticResource InputFrame}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="👤"
                                   FontSize="18" VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   x:Name="NameEntry"
                                   Placeholder="Full Name"
                                   Style="{StaticResource InputEntry}"/>
                        </Grid>
                    </Frame>

                    <!-- Email -->
                    <Frame Style="{StaticResource InputFrame}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="✉️"
                                   FontSize="18" VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   x:Name="EmailEntry"
                                   Placeholder="University Email"
                                   Keyboard="Email"
                                   Style="{StaticResource InputEntry}"/>
                        </Grid>
                    </Frame>

                    <!-- Password -->
                    <Frame Style="{StaticResource InputFrame}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="🔒"
                                   FontSize="18" VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   x:Name="PasswordEntry"
                                   Placeholder="Password"
                                   IsPassword="True"
                                   TextChanged="OnPasswordChanged"
                                   Style="{StaticResource InputEntry}"/>
                            <Label Grid.Column="2"
                                   x:Name="TogglePasswordLabel"
                                   Text="👁" FontSize="18"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTogglePassword"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Frame>

                    <!-- Password Strength -->
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                            <BoxView x:Name="StrengthBar1" Grid.Column="0"
                                     HeightRequest="4" CornerRadius="2"
                                     Color="#E5E7EB"/>
                            <BoxView x:Name="StrengthBar2" Grid.Column="1"
                                     HeightRequest="4" CornerRadius="2"
                                     Color="#E5E7EB"/>
                            <BoxView x:Name="StrengthBar3" Grid.Column="2"
                                     HeightRequest="4" CornerRadius="2"
                                     Color="#E5E7EB"/>
                            <BoxView x:Name="StrengthBar4" Grid.Column="3"
                                     HeightRequest="4" CornerRadius="2"
                                     Color="#E5E7EB"/>
                        </Grid>
                        <Label x:Name="StrengthLabel"
                               Text="Password strength"
                               Style="{StaticResource CaptionLabel}"
                               HorizontalOptions="End"/>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <Frame Style="{StaticResource InputFrame}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="🔐"
                                   FontSize="18" VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   x:Name="ConfirmPasswordEntry"
                                   Placeholder="Confirm Password"
                                   IsPassword="True"
                                   Style="{StaticResource InputEntry}"/>
                        </Grid>
                    </Frame>

                    <!-- Terms -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="TermsCheckBox"
                                  Color="{StaticResource PrimaryColor}"/>
                        <Label VerticalOptions="Center" FontSize="13"
                               TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="I agree to the "/>
                                    <Span Text="Terms &amp; Privacy Policy"
                                          TextColor="{StaticResource PrimaryColor}"
                                          FontAttributes="Bold"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Error -->
                    <Label x:Name="ErrorLabel"
                           TextColor="{StaticResource ErrorColor}"
                           FontSize="13" IsVisible="False"
                           HorizontalOptions="Center"/>

                    <!-- Register Button -->
                    <Button x:Name="RegisterButton"
                            Text="Create Account"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnRegisterClicked"
                            Margin="0,4,0,0"/>

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False" IsVisible="False"
                                       Color="{StaticResource PrimaryColor}"
                                       HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Login Link -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Margin="0,24,0,40" Spacing="4">
                <Label Text="Already have an account?"
                       Style="{StaticResource BodyLabel}"/>
                <Label Text="Sign In"
                       TextColor="{StaticResource PrimaryColor}"
                       FontAttributes="Bold" FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
